[{"level_id":10,"level_name":"Default","level_order":0,"type_id":10,"locations":[{"location_id":64,"location_name":"Default","location_order":1,"collectibles":[{"id":66,"title":"Symbol of Legacy Earrings","description":{"type":"text","content":"Acquired by choosing the \"Making New Memories\" ending."},"display_order":7,"cycle":"NG+","quantity":1,"subtype":null,"types":["Earrings"],"images":[{"id":71,"url":"https://img.stellarbladeguide.com/stellar-blade/collectibles/xion/xion/stellar-blade-20260320183956.webp","alt":"Symbol of Legacy Earrings","order":1}]}]}]},{"level_id":1,"level_name":"Eidos 7","level_order":1,"type_id":10,"locations":[{"location_id":6,"location_name":"Construction Zone","location_order":6,"collectibles":[{"id":101,"title":"Crimson Tear Earrings","description":{"type":"text","content":"Once you have the keys and control of the cranes, use the left crane to destroy the sculpture on the wall to the left of the sewer entrance, then shift the girder slightly left. Cross the girder to grab the Supply Box in the small room behind the broken wall, then jump into the building to the left. Take out the Cricket Slasher inside and loot the nearby body for a Body Core.\n\nFrom where you climbed up, look right to spot a neighbouring building you can jump to, it has Memorystick - Legionnaire 326's Transmission. Now look back at the first building to find handholds leading up. Climb to the next floor, clear the Creepers, and push through the room. Watch for a Cricket Slasher that ambushes you around the corner. The black box with Crimson Tear Earrings is in this area."},"display_order":15,"cycle":"Base","quantity":1,"subtype":null,"types":["Earrings"],"images":[{"id":110,"url":"https://img.stellarbladeguide.com/stellar-blade/collectibles/eidos-7/construction-zone/stellar-blade-20240514231815.webp","alt":"Crimson Tear Earrings","order":1},{"id":111,"url":"https://img.stellarbladeguide.com/stellar-blade/collectibles/eidos-7/construction-zone/stellar-blade-20260320183910.webp","alt":"Crimson Tear Earrings","order":2}]},{"id":102,"title":"Noble Tear Earrings","description":{"type":"text","content":"Replaces Crimson Tear Earrings on NG+. Found in the black box in the room above the handholds in the Construction Zone."},"display_order":16,"cycle":"NG+","quantity":1,"subtype":null,"types":["Earrings"],"images":[{"id":112,"url":"https://img.stellarbladeguide.com/stellar-blade/collectibles/eidos-7/construction-zone/stellar-blade-20240514231815.webp","alt":"Noble Tear Earrings","order":1},{"id":113,"url":"https://img.stellarbladeguide.com/stellar-blade/collectibles/eidos-7/construction-zone/stellar-blade-20260320183913.webp","alt":"Noble Tear Earrings","order":2}]},{"id":103,"title":"Golden Heart Earrings","description":{"type":"text","content":"Replaces Noble Tear Earrings on NG++. Found in the black box in the room above the handholds in the Construction Zone."},"display_order":17,"cycle":"NG++","quantity":1,"subtype":null,"types":["Earrings"],"images":[]}]},{"location_id":8,"location_name":"Crater","location_order":8,"collectibles":[{"id":113,"title":"Hanging Memory Earrings","description":{"type":"text","content":"Pick up the Bulletin Board Request: Generous Drop Pod, then travel back to the Crater in Eidos 7. Interact with the drop pod where you rescued Lily earlier to receive Hanging Memory Earrings."},"display_order":6,"cycle":"Base","quantity":1,"subtype":null,"types":["Earrings"],"images":[{"id":127,"url":"https://img.stellarbladeguide.com/stellar-blade/collectibles/eidos-7/eidos-7-continued/stellar-blade-20240528205010.webp","alt":"Hanging Memory Earrings","order":1},{"id":128,"url":"https://img.stellarbladeguide.com/stellar-blade/collectibles/eidos-7/eidos-7-continued/stellar-blade-20240528205037.webp","alt":"Hanging Memory Earrings","order":2},{"id":129,"url":"https://img.stellarbladeguide.com/stellar-blade/collectibles/eidos-7/crater/stellar-blade-20260320183939.webp","alt":"Hanging Memory Earrings","order":3}]},{"id":